const speakeasy = require('speakeasy');
const QRCode = require('qrcode');
const pool = require('../config/db');
const { registrarBitacora } = require('../services/bitacora.service');


async function setup2fa(req, res) {
const userId = req.params.userId;
try {
await registrarBitacora({ usuario: userId, accion: 'INICIO_CONFIGURACION_2FA', descripcion: 'Iniciando 2FA', modulo: 'SEGURIDAD', req, estado: 'EXITO' });


const [user] = await pool.query('SELECT ID_USUARIO FROM TBL_MS_USUARIO WHERE USUARIO = ?', [userId]);
if (!user.length) return res.status(404).send('Usuario no encontrado');


const secret = speakeasy.generateSecret({ name: `Roca Maya (${userId})`, issuer: 'Sistema Roca Maya', length: 20 });
await pool.query('UPDATE TBL_MS_USUARIO SET SECRET_2FA = ?, ACTIVO_2FA = 1, FECHA_ACTIVACION_2FA = NOW() WHERE USUARIO = ?', [secret.base32, userId]);


const dataUrl = await QRCode.toDataURL(secret.otpauth_url);
res.render('setup-2fa', { userId, data_url: dataUrl, secret: secret.base32 });
} catch (err) {
console.error('setup2fa error', err);
await registrarBitacora({ usuario: userId, accion: 'ERROR_CONFIGURACION_2FA', descripcion: err.message, modulo: 'SEGURIDAD', req, estado: 'ERROR', detalleError: err.message });
res.status(500).send('Error configurando 2FA');
}
}


