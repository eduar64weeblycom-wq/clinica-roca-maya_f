<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clínicas Roca Maya - Autenticación</title>
  <link rel="icon" href="/ICONO.jpg" type="image/jpeg">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Logo fijo -->
  <img src="/roca-maya-oct.jpg" alt="Logo Roca Maya" class="logo-fixed" onerror="this.style.display='none'">

  <div class="auth-container">
    <div class="auth-header">
      <h1>Clínicas <span class="clinic-name">Roca Maya</span></h1>
      <p class="mb-0 text-muted">Tu salud es nuestra seguridad</p>
    </div>

    <!-- Tabs -->
    <div class="auth-tabs">
      <button class="auth-tab active" data-tab="login"><i class="fas fa-sign-in-alt me-2"></i>Ingresar</button>
      <button class="auth-tab" data-tab="register"><i class="fas fa-user-plus me-2"></i>Registrarse</button>
    </div>

    <div class="auth-forms">
      <!-- Mensajes -->
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
          <i class="fas fa-exclamation-triangle me-2"></i><%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
          <i class="fas fa-check-circle me-2"></i><%= success %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- LOGIN -->
      <form action="/auth/login" method="POST" id="form-login" class="auth-form active">
        <div class="welcome-text">
          <i class="fas fa-heartbeat me-2"></i>Bienvenido al Sistema
        </div>

        <!-- USUARIO - Con validación (sin espacios, permite símbolos) -->
        <div class="form-group mb-3">
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-user"></i></span>
            <input 
              type="text" 
              name="nombre_usuario" 
              class="form-control" 
              placeholder="Usuario *" 
              required
              minlength="5"
              maxlength="25"
              value="<%= typeof username !== 'undefined' ? username : '' %>"
              autocomplete="off"
            >
          </div>
       
        </div>

        <div class="form-group mb-4">
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock"></i></span>
            <input type="password" name="password" class="form-control password-field" placeholder="Contraseña *" required>
            <button type="button" class="btn btn-outline-secondary toggle-password"><i class="fas fa-eye"></i></button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 mb-3" id="login-btn">
          <span class="btn-text"><i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión</span>
          <div class="btn-loading d-none"><i class="fas fa-spinner fa-spin me-2"></i>Ingresando...</div>
        </button>

        <div class="text-center">
          <a href="#" class="text-link switch-form" data-form="register">¿No tienes cuenta? Regístrate</a>
        </div>
      </form>

      <!-- REGISTRO -->
      <form action="/auth/register" method="POST" id="form-register" class="auth-form">
        <!-- NOMBRE COMPLETO - Solo letras -->
        <div class="form-group mb-3">
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-id-card"></i></span>
            <input
              type="text"
              name="nombre_completo"
              class="form-control"
              placeholder="Nombre completo *"
              required
              minlength="3"
              maxlength="60"
              value="<%= typeof nombre_completo !== 'undefined' ? nombre_completo : '' %>"
              autocomplete="off"
            >
          </div>

        </div>

        <!-- USUARIO - Sin espacios, permite símbolos -->
        <div class="form-group mb-3">
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-user"></i></span>
            <input 
              type="text" 
              name="usuario" 
              class="form-control" 
              placeholder="Usuario *" 
              required 
              minlength="5"
              maxlength="25" 
              value="<%= typeof usuario !== 'undefined' ? usuario : '' %>"
              autocomplete="off"
            >
          </div>
          
        </div>

        <!-- CONTRASEÑA -->
        <div class="form-group mb-3">
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock"></i></span>
            <input type="password" name="contrasena" class="form-control password-field" 
              placeholder="Contraseña *" required minlength="9" maxlength="15"
              oncopy="return false" onpaste="return false" autocomplete="new-password">
            <button type="button" class="btn btn-outline-secondary toggle-password">
              <i class="fas fa-eye"></i>
            </button>
          </div>
         
        </div>

        <!-- CONFIRMAR CONTRASEÑA -->
        <div class="form-group mb-3">
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock"></i></span>
            <input type="password" name="confirm_contrasena" class="form-control password-field"
              placeholder="Confirmar contraseña *" required minlength="9" maxlength="15"
              oncopy="return false" onpaste="return false" autocomplete="new-password">
            <button type="button" class="btn btn-outline-secondary toggle-password">
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <!-- CORREO ELECTRÓNICO -->
        <div class="form-group mb-4">
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
            <input type="email" name="correo_electronico" class="form-control"
              placeholder="Correo electrónico *" required maxlength="50"
              value="<%= typeof email !== 'undefined' ? email : '' %>"
              autocomplete="email"
            >
          </div>
        
        </div>

        <!-- Indicador de fortaleza de contraseña -->
        <div class="mb-3">
          <div class="progress" style="height: 5px;">
            <div id="passwordStrength" class="progress-bar" style="width: 0%; transition: width 0.3s;"></div>
          </div>
          <small id="passwordHelp" class="form-text text-muted">La contraseña debe tener mínimo 9 caracteres, letras, números y un símbolo</small>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2" id="register-btn">
          <span class="btn-text"><i class="fas fa-user-plus me-2"></i>Registrarse</span>
          <div class="btn-loading d-none"><i class="fas fa-spinner fa-spin me-2"></i>Registrando...</div>
        </button>

        <div class="text-center mt-3">
          <a href="#" class="text-link switch-form" data-form="login">¿Ya tienes cuenta? Inicia sesión</a>
        </div>
      </form>
      
      <div class="text-center mt-2">
        <a href="/auth/forgot-password" class="text-link">
          <i class="fas fa-key me-2"></i>¿Olvidaste tu contraseña?
        </a>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/auth.js"></script>
</body>
</html>