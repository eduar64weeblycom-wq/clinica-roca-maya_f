<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Parámetros de Seguridad - Clínicas Roca Maya</title>
    <link rel="icon" href="/ICONO.jpg" type="image/jpeg">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #3cc5ae 0%, #4bc9ef 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #0d5b84 0%, #0b4a6b 100%);
            padding: 25px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 4px solid #ff4d4d;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .logo-btn {
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.2);
            cursor: pointer;
            padding: 10px;
            border-radius: 12px;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            text-decoration: none;
        }

        .logo-btn:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateY(-2px);
            text-decoration: none;
        }

        .logo {
            height: 60px;
            width: auto;
        }

        .clinic-name {
            font-size: 28px;
            font-weight: 800;
            color: white;
        }

        .main-content {
            padding: 30px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #eaeaea;
        }

        .page-title {
            font-size: 2.5rem;
            font-weight: 800;
            text-align: center;
            background: linear-gradient(135deg, #3cc5ae, #4bc9ef);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin: 0;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            font-size: 14px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #0d5b84 0%, #0b4a6b 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(13, 91, 132, 0.3);
            color: white;
        }

        .btn-success {
            background: linear-gradient(135deg, #2fbf92, #3cd6aa);
            color: white;
            border: none;
            font-weight: 700;
        }

        .btn-success:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0, 176, 155, 0.35);
            color: white;
        }

        .btn-secondary {
            background: rgba(255, 255, 255, 0.2);
            border: 2px solid rgba(255, 255, 255, 0.3);
            color: white;
            padding: 12px 24px;
            border-radius: 10px;
            text-decoration: none;
            transition: 0.3s ease;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            color: white;
        }

        .table-container {
            background: white;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
            margin-bottom: 30px;
            overflow-x: auto;
        }

        .parametros-table {
            width: 100%;
            border-collapse: collapse;
            min-width: 800px;
        }

        .parametros-table th {
            background: linear-gradient(135deg, #3cc5ae 0%, #4bc9ef 100%);
            color: white;
            padding: 20px 15px;
            text-align: left;
            font-weight: 600;
            font-size: 16px;
            text-transform: uppercase;
        }

        .parametros-table td {
            padding: 12px;
            border-bottom: 1px solid #eaeaea;
            color: #444;
            vertical-align: middle;
        }

        .parametros-table tr:nth-child(even) {
            background: #f8fdfc;
        }

        .parametros-table tr:hover {
            background: #e9fbf7;
        }

        .valor-input {
            width: 100%;
            padding: 8px 12px;
            border: 2px solid #c2e8e0;
            border-radius: 10px;
            font-size: 14px;
            transition: all 0.3s ease;
            background: #ffffff;
            font-weight: 600;
        }

        .valor-input:focus {
            outline: none;
            border-color: #3cc5ae;
            box-shadow: 0 0 0 3px rgba(60, 197, 174, 0.25);
        }

        .is-invalid {
    border-color: #dc3545 !important;
    background-color: #fff8f8 !important;
}

.input-modified {
    border-color: #28a745 !important;
    background-color: #f8fff9 !important;
}

        .parametro-codigo {
            font-weight: 700;
            color: #0d5b84;
            font-family: 'Courier New', monospace;
            font-size: 14px;
        }

        .parametro-descripcion {
            color: #555;
            font-size: 14px;
            line-height: 1.4;
        }

        .actions-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding: 15px 20px;
            background: #f8f9fa;
            border-radius: 8px;
            border-left: 4px solid #3cc5ae;
        }

        .actions-buttons {
            display: flex;
            gap: 10px;
        }

        .footer {
            text-align: center;
            padding: 30px;
            color: #4a665f;
            border-top: 2px solid #d6efe9;
            margin-top: 20px;
        }

        .loading {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.5);
            z-index: 9999;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: 18px;
        }

        .text-center {
            text-align: center;
        }

        .input-modified {
            border-color: #f6ad55 !important;
            background-color: #fff7e6 !important;
        }

        .input-error {
            border-color: #ff6b6b !important;
            background-color: #ffe6e6 !important;
        }

        .alert {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 10000;
            min-width: 300px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        .logo-error {
            background: rgba(255,255,255,0.1);
            color: white;
            padding: 10px 15px;
            border-radius: 8px;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <div class="logo-container">
                <a href="/dashboard" class="logo-btn" id="logoBtn">
                    <img src="/roca-maya-oct.jpg" alt="Clínicas Roca Maya" class="logo" 
                         onerror="this.style.display='none'; document.getElementById('logoText').style.display='block';">
                    <span id="logoText" class="logo-error" style="display: none;">CLÍNICAS ROCA MAYA</span>
                </a>
                <div class="clinic-name">Clínicas Roca Maya</div>
            </div>
        </div>

        <div class="main-content">
            <div class="page-header">
                <h1 class="page-title">
                    <i class="fas fa-sliders-h"></i> Parámetros de Seguridad
                </h1>
            </div>

       <div class="actions-buttons">
          <button class="btn btn-success" id="btnGuardar">
            <i class="fas fa-save"></i> Guardar Cambios
    <input type="file" id="fileRestore" style="display: none;" accept=".sql">
           </div>
            </div>
            <div class="table-container">
                <table class="parametros-table">
                    <thead>
                        <tr>
                            <th width="20%">Parámetro</th>
                            <th width="45%">Descripción</th>
                            <th width="35%">Valor</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (parametros && parametros.length > 0) { %>
                            <% parametros.forEach(p => { %>
                                <tr>
                                    <td>
                                        <span class="parametro-codigo"><%= p.ID_PARAMETRO %></span>
                                    </td>
                                    <td>
                                        <div class="parametro-descripcion">
                                            <strong><%= p.PARAMETRO %></strong>
                                            <% if (p.DESCRIPCION) { %>
                                                <br><small class="text-muted"><%= p.DESCRIPCION %></small>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td>
                                        <input type="text" 
       class="valor-input valor-parametro" 
       data-id="<%= p.ID_PARAMETRO %>" 
       data-clave="<%= p.PARAMETRO %>"
       data-original-value="<%= p.VALOR %>"
       value="<%= p.VALOR %>"
       placeholder="Ingrese el valor...">
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="text-center" style="padding: 40px; color: #666;">
                                    <i class="fas fa-exclamation-circle" style="font-size: 48px; margin-bottom: 15px; display: block; color: #ccc;"></i>
                                    No hay parámetros configurados en el sistema
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <div class="footer">
                <small>Clínicas Roca Maya - Sistema de Gestión © 2025</small>
            </div>
        </div>
    </div>

    <div class="loading" id="loading">
        <div style="text-align: center;">
            <i class="fas fa-spinner fa-spin" style="font-size: 48px; margin-bottom: 15px;"></i>
            <div>Procesando...</div>
        </div>
    </div>

    <!-- Incluir el archivo JavaScript externo -->
    <script src="/js/parametros.js"></script>
</body>
</html>