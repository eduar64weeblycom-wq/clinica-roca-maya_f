<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clínicas Roca Maya - Restablecer Contraseña</title>
  <link rel="icon" href="/ICONO.jpg" type="image/jpeg">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Logo fijo -->
  <img src="/roca-maya-oct.jpg" alt="Logo Roca Maya" class="logo-fixed" onerror="this.style.display='none'">

  <div class="auth-container">
    <div class="auth-header">
      <h1>Clínicas <span class="clinic-name">Roca Maya</span></h1>
      <p class="mb-0 text-muted">Restablece tu contraseña de forma segura</p>
    </div>

    <div class="auth-forms">
      <form action="/auth/reset-password" method="POST" id="form-reset-password" class="auth-form active">

        <div class="welcome-text mb-3">
          <i class="fas fa-key me-2"></i>Restablecer contraseña
        </div>

        <% if (typeof error !== "undefined" && error) { %>
          <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <% if (typeof success !== "undefined" && success) { %>
          <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
            <i class="fas fa-check-circle me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <!-- Input oculto con userId -->
        <input type="hidden" name="userId" value="<%= userId %>">

        <!-- Nueva contraseña -->
        <div class="form-group mb-3">
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock"></i></span>
            <input 
              type="password" 
              name="pass1" 
              id="pass1"
              class="form-control password-field" 
              placeholder="Nueva contraseña *" 
              required 
              minlength="9" 
              maxlength="15"
              autocomplete="new-password"
            >
            <button type="button" class="btn btn-outline-secondary toggle-password" data-target="pass1">
              <i class="fas fa-eye"></i>
            </button>
          </div>
          <small class="form-text text-muted">Mínimo 9 caracteres, máximo 15</small>
        </div>

        <!-- Confirmar contraseña -->
        <div class="form-group mb-4">
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock"></i></span>
            <input 
              type="password" 
              name="pass2" 
              id="pass2"
              class="form-control password-field" 
              placeholder="Confirmar contraseña *" 
              required 
              minlength="9" 
              maxlength="15"
              autocomplete="new-password"
            >
            <button type="button" class="btn btn-outline-secondary toggle-password" data-target="pass2">
              <i class="fas fa-eye"></i>
            </button>
          </div>
        </div>

        <!-- Indicador de fortaleza de contraseña -->
        <div class="mb-3">
          <div class="progress" style="height: 5px;">
            <div id="passwordStrength" class="progress-bar" style="width: 0%; transition: width 0.3s;"></div>
          </div>
          <small id="passwordHelp" class="form-text text-muted">La contraseña debe tener mínimo 9 caracteres, letras, números y un símbolo</small>
        </div>

        <button type="submit" class="btn btn-success w-100 py-2" id="reset-btn">
          <span class="btn-text"><i class="fas fa-check-circle me-2"></i>Guardar</span>
          <div class="btn-loading d-none"><i class="fas fa-spinner fa-spin me-2"></i>Guardando...</div>
        </button>

        <div class="text-center mt-3">
          <a href="/auth/login" class="text-link">
            <i class="fas fa-arrow-left me-1"></i>Volver al inicio de sesión
          </a>
        </div>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <script>
  document.addEventListener('DOMContentLoaded', function() {

    // ============================================================
    // 1. ELEMENTOS
    // ============================================================
    const pass1 = document.getElementById('pass1');
    const pass2 = document.getElementById('pass2');
    const resetForm = document.getElementById('form-reset-password');
    const strengthBar = document.getElementById('passwordStrength');
    const strengthHelp = document.getElementById('passwordHelp');

    if (!pass1 || !pass2 || !resetForm) return;

    // ============================================================
    // 2. INDICADOR DE FORTALEZA EN TIEMPO REAL
    // ============================================================
    function actualizarFortaleza() {
      const password = pass1.value;
      if (!password) {
        strengthBar.style.width = '0%';
        strengthBar.className = 'progress-bar';
        strengthHelp.textContent = 'La contraseña debe tener mínimo 9 caracteres, letras, números y un símbolo';
        strengthHelp.style.color = '#6c757d';
        return;
      }

      let puntos = 0;
      if (password.length >= 9) puntos++;
      if (password.length >= 12) puntos++;
      if (/[a-z]/.test(password) && /[A-Z]/.test(password)) puntos++;
      if (/\d/.test(password)) puntos++;
      if (/[@$!%*#?&]/.test(password)) puntos++;

      const porcentaje = Math.min((puntos / 5) * 100, 100);
      strengthBar.style.width = porcentaje + '%';

      if (puntos <= 2) {
        strengthBar.className = 'progress-bar bg-danger';
        strengthHelp.textContent = '⚠️ Contraseña débil';
        strengthHelp.style.color = '#dc3545';
      } else if (puntos <= 3) {
        strengthBar.className = 'progress-bar bg-warning';
        strengthHelp.textContent = '⚠️ Contraseña media';
        strengthHelp.style.color = '#856404';
      } else if (puntos <= 4) {
        strengthBar.className = 'progress-bar bg-info';
        strengthHelp.textContent = '✅ Contraseña fuerte';
        strengthHelp.style.color = '#0c5460';
      } else {
        strengthBar.className = 'progress-bar bg-success';
        strengthHelp.textContent = '✅ Contraseña muy fuerte';
        strengthHelp.style.color = '#155724';
      }
    }

    pass1.addEventListener('input', actualizarFortaleza);

    // ============================================================
    // 3. ✅ MOSTRAR/OCULTAR CONTRASEÑA - CORREGIDO
    // ============================================================
    document.querySelectorAll('.toggle-password').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        const targetId = this.getAttribute('data-target');
        const input = document.getElementById(targetId);
        const icon = this.querySelector('i');
        
        if (input) {
          if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
          } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
          }
        }
      });
    });

    // ============================================================
    // 4. VALIDACIÓN ANTES DE ENVIAR
    // ============================================================
    resetForm.addEventListener('submit', function(e) {
      // Obtener valores
      const p1 = pass1.value;
      const p2 = pass2.value;

      // 4.1 Verificar que no estén vacíos
      if (!p1 || !p2) {
        e.preventDefault();
        alert('⚠️ Ambos campos de contraseña son obligatorios.');
        return false;
      }

      // 4.2 Verificar longitud (9-15)
      if (p1.length < 9) {
        e.preventDefault();
        alert('⚠️ La contraseña debe tener mínimo 9 caracteres. (Tiene ' + p1.length + ')');
        return false;
      }
      if (p1.length > 15) {
        e.preventDefault();
        alert('⚠️ La contraseña debe tener máximo 15 caracteres. (Tiene ' + p1.length + ')');
        return false;
      }

      // 4.3 Verificar que coincidan
      if (p1 !== p2) {
        e.preventDefault();
        alert('⚠️ Las contraseñas no coinciden.');
        return false;
      }

      // 4.4 Verificar que tenga al menos una letra
      if (!/[A-Za-z]/.test(p1)) {
        e.preventDefault();
        alert('⚠️ La contraseña debe contener al menos una letra.');
        return false;
      }

      // 4.5 Verificar que tenga al menos un número
      if (!/\d/.test(p1)) {
        e.preventDefault();
        alert('⚠️ La contraseña debe contener al menos un número.');
        return false;
      }

      // 4.6 Verificar que tenga al menos un símbolo
      if (!/[@$!%*#?&]/.test(p1)) {
        e.preventDefault();
        alert('⚠️ La contraseña debe contener al menos uno de estos símbolos: @ $ ! % * # ? &');
        return false;
      }

      // ✅ Todas las validaciones pasaron
      return true;
    });

    // ============================================================
    // 5. LIMITAR CARACTERES A 15
    // ============================================================
    pass1.addEventListener('input', function() {
      if (this.value.length > 15) {
        this.value = this.value.slice(0, 15);
      }
    });

    pass2.addEventListener('input', function() {
      if (this.value.length > 15) {
        this.value = this.value.slice(0, 15);
      }
    });

    // ============================================================
    // 6. VALIDACIÓN EN TIEMPO REAL DE CONFIRMACIÓN
    // ============================================================
    pass2.addEventListener('input', function() {
      const p1 = pass1.value;
      const p2 = this.value;
      
      if (p2 && p2 !== p1) {
        this.classList.add('is-invalid');
        this.classList.remove('is-valid');
      } else if (p2 && p2 === p1) {
        this.classList.remove('is-invalid');
        this.classList.add('is-valid');
      } else {
        this.classList.remove('is-invalid', 'is-valid');
      }
    });

    pass1.addEventListener('input', function() {
      // Si pass2 tiene texto, validarlo
      if (pass2.value) {
        const event = new Event('input');
        pass2.dispatchEvent(event);
      }
    });

    // ============================================================
    // 7. INICIALIZAR
    // ============================================================
    actualizarFortaleza();
    console.log('✅ Validaciones de reset-password activas');
  });
  </script>

</body>
</html>