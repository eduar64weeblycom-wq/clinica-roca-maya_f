<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .error-container {
            margin-top: 100px;
            text-align: center;
        }
        .error-code {
            font-size: 8rem;
            font-weight: bold;
            color: #dc3545;
        }
    </style>
</head>
<body>
    <div class="container error-container">
        <div class="error-code">
            <%= typeof status !== 'undefined' ? status : 500 %>
        </div>
        <h2>Ups, algo salió mal</h2>
        <p class="lead">
            <%= typeof message !== 'undefined' ? message : 'Ha ocurrido un error en el servidor.' %>
        </p>
        <a href="/auth/login" class="btn btn-primary mt-3">Volver al inicio</a>
    </div>
</body>
</html>