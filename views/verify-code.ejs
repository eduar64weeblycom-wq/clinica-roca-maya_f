<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clínicas Roca Maya - Verificar Código</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Logo fijo -->
  <img src="/roca-maya-oct.jpg" alt="Logo Roca Maya" class="logo-fixed" onerror="this.style.display='none'">

  <div class="auth-container">
    <div class="auth-header mb-4 text-center">
      <h1>Clínicas <span class="clinic-name">Roca Maya</span></h1>
      <p class="mb-0 text-muted">Ingresa el código enviado a tu correo</p>
    </div>

    <form action="/auth/verify-code" method="POST" class="auth-form active p-4">

      <% if (typeof error !== "undefined" && error) { %>
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
          <i class="fas fa-exclamation-circle me-2"></i><%= error %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <!-- Input oculto con userId -->
      <input type="hidden" name="userId" value="<%= userId %>">

      <!-- Código -->
      <div class="form-group mb-4">
        <label class="form-label fw-semibold">Código de verificación</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fas fa-key"></i></span>
          <input type="number" name="codigo" class="form-control" placeholder="Ingresa tu código" required>
        </div>
      </div>

      <button type="submit" class="btn btn-primary w-100 py-2">
        <span class="btn-text"><i class="fas fa-check-circle me-2"></i>Verificar</span>
        <div class="btn-loading d-none"><i class="fas fa-spinner fa-spin me-2"></i>Verificando...</div>
      </button>

      <div class="text-center mt-3">
        <a href="/auth/login" class="text-link">
          <i class="fas fa-arrow-left me-1"></i>Volver al inicio de sesión
        </a>
      </div>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
