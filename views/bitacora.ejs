<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bitácora - Clínicas Roca Maya</title>
<link rel="icon" href="/ICONO.jpg" type="image/jpeg">

  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <script src="/js/bitacora.js"></script>
  <link rel="stylesheet" href="/css/bitacora.css">
</head>

<body>

  <div class="container">
    <div class="header">
      <div class="logo-container">
        <button class="logo-btn" id="logoBtn" title="Volver al Dashboard">
          <img src="/roca-maya-oct.jpg" alt="Clínicas Roca Maya" class="logo">
        </button>
        <div class="clinic-name">Clínicas Roca Maya</div>
      </div>
    </div>

    <div class="main-content">
      <div class="page-header">
        <h1 class="page-title">Bitácora del Sistema</h1>
        <div class="actions">
          <button class="btn btn-primary" id="btnImprimir">
            <i class="fas fa-print"></i> Imprimir
          </button>
          <!-- BOTÓN EXCEL AGREGADO -->
          <a href="/excel/bitacora" class="btn btn-excel">
            <i class="fas fa-file-excel"></i> Descargar Excel
          </a>
        </div>
      </div>

      <div class="filters">
        <div class="filter-group">
          <label class="filter-label">Fecha desde:</label>
          <input type="date" class="filter-input" id="fechaDesde">
        </div>
        <div class="filter-group">
          <label class="filter-label">Fecha hasta:</label>
          <input type="date" class="filter-input" id="fechaHasta">
        </div>
        <div class="filter-group">
          <label class="filter-label">Usuario:</label>
          <input type="text" class="filter-input" id="usuarioFilter" placeholder="Filtrar por usuario...">
        </div>
        <div class="filter-group">
          <label class="filter-label">Módulo:</label>
          <input type="text" class="filter-input" id="moduloFilter" placeholder="Filtrar por módulo...">
        </div>
        <div class="filter-group">
          <label class="filter-label">Descripción:</label>
          <input type="text" class="filter-input" id="descripcionFilter" placeholder="Filtrar por descripción...">
        </div>

        <button class="btn btn-primary" id="btnAplicarFiltros">
          <i class="fas fa-filter"></i> Aplicar Filtros
        </button>
        <button class="btn btn-secondary" id="btnLimpiarFiltros">
          <i class="fas fa-times"></i> Limpiar
        </button>
      </div>

      <div class="table-container">
        <table class="bitacora-table" id="bitacoraTable">
          <thead>
            <tr>
              <th>Fecha y Hora</th>
              <th>Usuario</th>
              <th>Acción</th>
              <th>Módulo</th>
              <th>Descripción</th>
            </tr>
          </thead>
          <tbody id="tablaBody">
            <% if (registros && registros.length > 0) { %>
              <% registros.forEach(r => { %>
                <tr class="fila-registro">
                  <td class="fecha-hora"><%= r.FECHA_HORA %></td>
                  <td class="usuario"><%= r.USUARIO %></td>
                  <td class="accion"><%= r.ACCION %></td>
                  <td class="modulo"><%= r.MODULO %></td>
                  <td class="descripcion"><%= r.DESCRIPCION %></td>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="5" class="no-results no-results-message">
                  No se encontraron registros de Bitácora en la base de datos.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

      <div class="filters" style="justify-content: space-between;">
        <div><strong>Total de registros:</strong> <span id="totalRegistros">0</span></div>
        <div><strong>Registros mostrados:</strong> <span id="registrosMostrados">0</span></div>
        <div><strong>Última actualización:</strong> <span id="ultimaActualizacion"></span></div>
      </div>
    </div>

    <div class="footer">
      Clínicas Roca Maya - Sistema de Gestión &copy; 2025
    </div>
  </div>

  <div id="loading" class="loading" style="display:none;">
    <div style="background: white; padding: 20px; border-radius: 10px; color: #333;">
      <i class="fas fa-spinner fa-spin"></i> Generando PDF...
    </div>
  </div>

  <script>
    // CÓDIGO PARA EL BOTÓN DE PARÁMETROS
    document.addEventListener('DOMContentLoaded', function() {
        const btnParametros = document.getElementById('btnParametros');
        
        if (btnParametros) {
            btnParametros.addEventListener('click', function() {
                console.log('Redirigiendo a parámetros de seguridad...');
                window.location.href = '/bitacora/parametros';
            });
        }
    });
  </script>
</body>
</html>